# pinsdaemon privilege delegation inside the pins container. Only the
# operations that have a working implementation in the container are listed
# (PHD2 control through the systemctl shim, ASTAP star database handling, the
# host's time zone, clock and keyboard through the host settings shims).
sysupdate-api ALL=(root) NOPASSWD: /usr/bin/systemctl
sysupdate-api ALL=(root) NOPASSWD: /usr/bin/timedatectl
sysupdate-api ALL=(root) NOPASSWD: /usr/bin/localectl
sysupdate-api ALL=(root) NOPASSWD: /usr/local/bin/manage-localization.sh *
sysupdate-api ALL=(root) NOPASSWD: /usr/local/bin/install-astap-star-database.sh *
sysupdate-api ALL=(root) NOPASSWD: /usr/local/bin/ensure-astap-data-links.sh
